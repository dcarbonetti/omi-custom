# Copy to scripts/local-first/omi-local.env and adjust. Read by scripts/local-first/omi-local.

# Your local OpenAI-compatible server.
#   Ollama:    http://127.0.0.1:11434/v1   (ollama serve; ollama pull <model>)
#   LM Studio: http://127.0.0.1:1234/v1    (Developer tab → Start server)
OMI_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# One model serves summaries, memories, action items and the backend's chat lanes.
# Needs tool calling and JSON-schema output. On a 16 GB Mac an 8B instruct model is a good
# start; with 32 GB+ try a 14B–32B one. Thinking variants are much slower here.
OMI_LOCAL_LLM_MODEL=qwen3:8b

# Optional: an embedding model for the backend's semantic search lanes. Leave empty and those
# lanes stay off (keyword search still works; the Mac does its own on-device embeddings).
OMI_LOCAL_EMBEDDING_MODEL=

# Where the local database, auth and logs live (outside the repository).
OMI_LOCAL_STATE_ROOT="$HOME/Library/Application Support/OmiLocal/harness"
OMI_LOCAL_INSTANCE=personal

# The desktop app bundle that talks to this stack (must start with omi-).
OMI_LOCAL_APP_NAME=omi-local
OMI_LOCAL_DISPLAY_NAME="Me"
