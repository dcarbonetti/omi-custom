#!/usr/bin/env bash
# Run Omi entirely on this Mac: local backend + local AI + the omi-local desktop app.
#
#   scripts/local-first/omi-local setup    one-time: install harness deps, create state
#   scripts/local-first/omi-local up       start database, auth, search, backend and gateway
#   scripts/local-first/omi-local app      build + launch the omi-local desktop app
#   scripts/local-first/omi-local status   show what is running
#   scripts/local-first/omi-local logs     tail service logs
#   scripts/local-first/omi-local down     stop everything (saves the local database)
#
# Settings come from scripts/local-first/omi-local.env (copy omi-local.env.example).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
cd "$REPO"

ENV_FILE="${OMI_LOCAL_ENV_FILE:-$HERE/omi-local.env}"
if [ ! -f "$ENV_FILE" ]; then
  echo "No $ENV_FILE yet — creating it from omi-local.env.example. Review it, then re-run."
  cp "$HERE/omi-local.env.example" "$ENV_FILE"
  exit 1
fi
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

# Local-AI mode: the harness requires no cloud keys and passes none to the backend; the LLM
# gateway serves every lane from OMI_LOCAL_LLM_BASE_URL (backend/llm_gateway/gateway/local_mode.py).
export PROVIDER_MODE=real
export OMI_ENV_STAGE=local
export OMI_LOCAL_LLM_BACKEND="${OMI_LOCAL_LLM_BACKEND:-openai}"
if [ "$OMI_LOCAL_LLM_BACKEND" = "claude-cli" ]; then
  # The gateway runs `claude -p` with your subscription; no local model server is used.
  unset OMI_LOCAL_LLM_BASE_URL
  export OMI_LOCAL_LLM_MODEL="${OMI_CLAUDE_MODEL:-sonnet}"
else
  export OMI_LOCAL_LLM_BASE_URL
fi
export OMI_LOCAL_STATE_ROOT OMI_LOCAL_INSTANCE OMI_LOCAL_LLM_MODEL
export OMI_LOCAL_EMBEDDING_MODEL="${OMI_LOCAL_EMBEDDING_MODEL:-}"
mkdir -p "$OMI_LOCAL_STATE_ROOT"
chmod 700 "$OMI_LOCAL_STATE_ROOT" 2>/dev/null || true

# shellcheck source=../dev-harness/_resolve_python.sh
source "$REPO/scripts/dev-harness/_resolve_python.sh"
helper() {
  local python_bin
  python_bin="$(dev_harness_python)"
  PYTHONPATH="$(dev_harness_pythonpath "$python_bin" scripts/dev-harness)" "$python_bin" "$HERE/omi_local.py" "$@"
}

cmd="${1:-}"
case "$cmd" in
  setup)
    make dev-init
    ;;
  up)
    helper check-llm
    make dev-up
    helper ensure-user
    echo
    echo "Local stack is up. Next: scripts/local-first/omi-local app"
    ;;
  app)
    helper app
    ;;
  status)
    make dev-status
    ;;
  logs)
    make dev-logs
    ;;
  down)
    # A clean stop exports the Firestore/Auth emulator data to the state root.
    make dev-down
    ;;
  check)
    helper check-llm
    make dev-check
    ;;
  *)
    sed -n '2,12p' "$0"
    exit 2
    ;;
esac
